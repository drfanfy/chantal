# =============================================================================
# CHANTAL — variables d'environnement (exemple SANS secret)
# Copier en .env (dev local) ; en recette/production, définir dans Vercel.
# Les variables VITE_* sont PUBLIQUES (incluses dans le navigateur) : jamais de secret.
# =============================================================================

# ── Supabase (client navigateur, public) ─────────────────────────────────────
VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé publishable / anon>

# ── Supabase (serveur uniquement) ────────────────────────────────────────────
SUPABASE_URL=https://<projet>.supabase.co
SUPABASE_ANON_KEY=<clé publishable / anon>
SUPABASE_SERVICE_ROLE_KEY=<clé service_role — SECRET, serveur uniquement>

# ── Environnement ────────────────────────────────────────────────────────────
APP_ENV=development              # development | staging | production
VITE_APP_ENV=development         # bandeau d'environnement côté interface

# ── Authentification / SSO (voir docs/05-sso.md) ─────────────────────────────
VITE_AUTH_PASSWORD_ENABLED=true  # false en production SSO
VITE_AUTH_SSO_MODE=none          # none | saml | oidc
VITE_AUTH_SSO_DOMAIN=            # ex. quartus.fr (SAML)
VITE_AUTH_SSO_PROVIDER_ID=       # identifiant fournisseur SAML Supabase (alternative au domaine)
VITE_AUTH_OIDC_PROVIDER=         # ex. azure (OIDC)
VITE_AUTH_SSO_LABEL=Se connecter avec mon compte QUARTUS
VITE_AUTH_SSO_LOGOUT_URL=        # optionnel : déconnexion globale IdP
AUTH_ADMIN_PASSWORD_CREATION=true  # false = création de comptes par invitation SSO uniquement
SSO_GROUP_SYNC=false             # true = rôles déduits des groupes SSO (table sso_group_role_mappings)

# ── Fournisseurs IA (serveur uniquement, référencés par nom dans le back-office) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
AZURE_OPENAI_API_KEY=
# Secrets supplémentaires : préfixe obligatoire CHANTAL_SECRET_ (ex. CHANTAL_SECRET_N8N_TOKEN=)

# ── Garde-fous réseau et limites ─────────────────────────────────────────────
AI_ALLOWED_HOSTS=                # hôtes autorisés pour endpoints « compatibles OpenAI » (ex. api.groq.com,*.openai.azure.com)
WORKFLOW_HTTP_ALLOWED_HOSTS=     # hôtes autorisés pour les étapes HTTP des workflows
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_CONCURRENT_PER_USER=3
WORKFLOW_MAX_ACTIVE_RUNS_PER_USER=2
CHAT_MAX_ATTACHMENT_BYTES=10485760
CHAT_TITLE_MODEL=                # identifiant API d'un modèle ACTIF pour les titres automatiques (vide = désactivé)
AI_ENABLE_MOCK_PROVIDER=false    # fournisseur fictif (tests/démo) — ignoré si APP_ENV=production

# ── Maintenance planifiée (cron Vercel → /api/cron/maintenance) ──────────────
CRON_SECRET=<chaîne aléatoire ≥ 16 caractères>
